---
import '@syntyr/css/core.css';
import '@syntyr/css/recipes.css';
import page from '../data/home.json';

// Inputs must pass scripts/export_cms_adapter.py before the build starts.
// Astro escapes text and attribute values; do not inject raw CMS markup.
const base = import.meta.env.BASE_URL;
const linkTo = (url: string) => url.startsWith('/') ? base + url.slice(1) : url;
const idFor = (section: { id: string }) => `section-${section.id}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={page.description} />
  <title>{page.title}</title>
</head>
<body class="syn-root" data-syn-theme={page.theme}>
  <a href="#content">Skip to content</a>
  <header class="syn-region">
    <nav aria-label="Primary"><a href={base}>Home</a></nav>
  </header>
  <main class="syn-shell" id="content">
    {page.sections.map((section, index) => (
      section.type === 'hero' ? (
        <section class="syn-region" aria-labelledby={idFor(section)}>
          <div class="syn-site-hero">
            <p class="syn-eyebrow">{section.eyebrow}</p>
            {index === 0
              ? <h1 class="syn-site-heading" id={idFor(section)}>{section.heading}</h1>
              : <h2 class="syn-site-heading" id={idFor(section)}>{section.heading}</h2>}
            <p class="syn-lede">{section.description}</p>
            <div class="syn-actions"><a class="syn-button syn-button--primary" href={linkTo(section.button.url)}>{section.button.label}</a></div>
          </div>
        </section>
      ) : section.type === 'features' ? (
        <section class="syn-region" aria-labelledby={idFor(section)}>
          <h2 class="syn-heading" id={idFor(section)}>{section.heading}</h2>
          <div class="syn-feature-grid">
            {section.items.map(item => (
              <article class="syn-feature-card"><h3>{item.title}</h3><p>{item.description}</p></article>
            ))}
          </div>
        </section>
      ) : section.type === 'pricing' ? (
        <section class="syn-region" aria-labelledby={idFor(section)}>
          <h2 class="syn-heading" id={idFor(section)}>{section.heading}</h2>
          <div class="syn-pricing">
            {section.plans.map(plan => (
              <article class="syn-price-card">
                <h3>{plan.name}</h3><p class="syn-price-value">{plan.price}</p>
                <ul class="syn-feature-list">{plan.features.map(feature => <li>{feature}</li>)}</ul>
                <a class="syn-button syn-button--primary" href={linkTo(plan.button.url)}>{plan.button.label}</a>
              </article>
            ))}
          </div>
        </section>
      ) : section.type === 'faq' ? (
        <section class="syn-region" aria-labelledby={idFor(section)}>
          <h2 class="syn-heading" id={idFor(section)}>{section.heading}</h2>
          <div class="syn-stack">
            {section.items.map(item => (
              <details class="syn-panel"><summary>{item.question}</summary><p>{item.answer}</p></details>
            ))}
          </div>
        </section>
      ) : section.type === 'cta' ? (
        <section class="syn-region syn-panel" aria-labelledby={idFor(section)}>
          <h2 class="syn-heading" id={idFor(section)}>{section.heading}</h2>
          <p class="syn-lede">{section.description}</p>
          <a class="syn-button syn-button--primary" href={linkTo(section.button.url)}>{section.button.label}</a>
        </section>
      ) : null
    ))}
  </main>
  <footer class="syn-region"><p class="syn-muted">{page.title}</p></footer>
</body>
</html>
