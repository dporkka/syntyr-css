{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dporkka/syntyr-css/blob/main/examples/cms-starter/blocks.schema.json",
  "title": "Syntyr CMS portable page v1",
  "description": "CMS-independent, allowlisted Syntyr marketing-page content. Not a raw HTML escape hatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "theme",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "theme": {
      "type": "string",
      "enum": [
        "studio",
        "grid",
        "noir",
        "industrial",
        "terminal",
        "corporate",
        "minimal"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/section"
      },
      "prefixItems": [
        {
          "$ref": "#/$defs/hero"
        }
      ]
    }
  },
  "$defs": {
    "section": {
      "oneOf": [
        {
          "$ref": "#/$defs/hero"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "heading",
            "items",
            "id"
          ],
          "properties": {
            "type": {
              "const": "features"
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "minLength": 1,
              "maxLength": 63,
              "description": "Stable section anchor slug, unique within the document."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "heading",
            "plans",
            "id"
          ],
          "properties": {
            "type": {
              "const": "pricing"
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "plans": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "price",
                  "features",
                  "button"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "price": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "features": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "button": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "url"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "description": "Root-relative or http(s) URL; renderer enforces URL safety."
                      }
                    }
                  }
                }
              }
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "minLength": 1,
              "maxLength": 63,
              "description": "Stable section anchor slug, unique within the document."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "heading",
            "items",
            "id"
          ],
          "properties": {
            "type": {
              "const": "faq"
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "answer"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "minLength": 1,
              "maxLength": 63,
              "description": "Stable section anchor slug, unique within the document."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "heading",
            "description",
            "button",
            "id"
          ],
          "properties": {
            "type": {
              "const": "cta"
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "button": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "description": "Root-relative or http(s) URL; renderer enforces URL safety."
                }
              }
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "minLength": 1,
              "maxLength": 63,
              "description": "Stable section anchor slug, unique within the document."
            }
          }
        }
      ]
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "eyebrow",
        "heading",
        "description",
        "button",
        "id"
      ],
      "properties": {
        "type": {
          "const": "hero"
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "button": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Root-relative or http(s) URL; renderer enforces URL safety."
            }
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Stable section anchor slug, unique within the document."
        }
      }
    }
  }
}
