{
  "version": 2,
  "framework": null,
  "installCommand": "echo 'No dependencies to install'",
  "buildCommand": "python3 scripts/build_saas_admin_starter.py",
  "outputDirectory": ".saas-admin-public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
