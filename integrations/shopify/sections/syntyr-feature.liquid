{% comment %}
  Shopify Online Store theme example. Add dist/syntyr.embed.css as
  assets/syntyr.embed.css and load once from layout/theme.liquid's head:
    {{ 'syntyr.embed.css' | asset_url | stylesheet_tag }}
{% endcomment %}
<section class="syn-root" data-syn-theme="studio">
  <div class="syn-panel">
    <h2 class="syn-heading">{{ section.settings.heading | escape }}</h2>
    <p class="syn-muted">{{ section.settings.description | escape }}</p>
    {% if section.settings.cta_url != blank and section.settings.cta_label != blank %}
      <a class="syn-button syn-button--primary" href="{{ section.settings.cta_url | escape }}">{{ section.settings.cta_label | escape }}</a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Syntyr feature",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Built for clarity"},
    {"type": "textarea", "id": "description", "label": "Description", "default": "A styled section that keeps the store theme intact."},
    {"type": "text", "id": "cta_label", "label": "Button label", "default": "Learn more"},
    {"type": "url", "id": "cta_url", "label": "Button link"}
  ],
  "presets": [{"name": "Syntyr feature"}]
}
{% endschema %}
