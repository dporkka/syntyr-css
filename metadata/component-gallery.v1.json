{
  "schema_version": 1,
  "source_version": "0.3.0-alpha.5",
  "completeness": "curated-examples",
  "source_of_truth": {
    "components": "metadata/components.json",
    "examples": "docs/catalog.html",
    "themes": "metadata/syntyr-api.json"
  },
  "scope": "syn-root",
  "runtime_requirement": "none",
  "note": "Unreleased source-tree candidate, not a guarantee of published alpha.4 availability. Host applications own behavior, data and validation.",
  "components": [
    {
      "name": "Button",
      "module": "syntyr.core.css",
      "elements": [
        "button",
        "a"
      ],
      "classes": [
        "syn-button",
        "syn-button--primary",
        "syn-button--outline",
        "syn-button--danger",
        "syn-button--ghost"
      ],
      "notes": "Use button for actions and a for navigation. ARIA states describe real application state."
    },
    {
      "name": "Panel",
      "module": "syntyr.core.css",
      "elements": [
        "article",
        "section",
        "div"
      ],
      "classes": [
        "syn-panel",
        "syn-panel--cut"
      ],
      "notes": "Choose native headings and accessible labels."
    },
    {
      "name": "Form fields",
      "module": "syntyr.core.css",
      "elements": [
        "form",
        "label",
        "input",
        "p"
      ],
      "classes": [
        "syn-form",
        "syn-label",
        "syn-input",
        "syn-error"
      ],
      "notes": "Real handlers and field validation belong to the application."
    },
    {
      "name": "Form compositions",
      "module": "syntyr.core.css",
      "elements": [
        "form",
        "label",
        "input",
        "button",
        "span",
        "div"
      ],
      "classes": [
        "syn-field",
        "syn-field-row",
        "syn-field-body",
        "syn-input-group",
        "syn-input-addon"
      ],
      "notes": "Unreleased alpha.5 candidate only. Native form behavior, associated labels, server validation; use syn-region for container-responsive rows. The Radix adapter is separately optional."
    },
    {
      "name": "Tables",
      "module": "syntyr.core.css",
      "elements": [
        "div",
        "table"
      ],
      "classes": [
        "syn-table-wrap",
        "syn-table",
        "syn-cell--numeric"
      ],
      "notes": "Use proper headers, captions and scroll containers."
    },
    {
      "name": "Stats",
      "module": "syntyr.core.css",
      "elements": [
        "section",
        "article",
        "p"
      ],
      "classes": [
        "syn-region",
        "syn-stats",
        "syn-stat",
        "syn-stat-label",
        "syn-stat-value"
      ],
      "notes": "Named container must be an ancestor of responsive children."
    },
    {
      "name": "Navigation",
      "module": "syntyr.core.css",
      "elements": [
        "nav",
        "ol",
        "li",
        "a"
      ],
      "classes": [
        "syn-breadcrumbs",
        "syn-pagination",
        "syn-page-link"
      ],
      "notes": "Real links and aria-current only for the actual current page."
    },
    {
      "name": "Application shell",
      "module": "syntyr.recipes.css",
      "elements": [
        "div",
        "aside",
        "main"
      ],
      "classes": [
        "syn-app-shell",
        "syn-app-rail",
        "syn-app-nav",
        "syn-workspace"
      ],
      "notes": "Load optional recipes CSS after core."
    },
    {
      "name": "Marketing hero",
      "module": "syntyr.recipes.css",
      "elements": [
        "section",
        "h1"
      ],
      "classes": [
        "syn-site-hero",
        "syn-site-heading"
      ],
      "notes": "Load optional recipes CSS after core."
    },
    {
      "name": "Charts",
      "module": "syntyr.viz.css",
      "elements": [
        "figure",
        "figcaption"
      ],
      "classes": [
        "syn-chart",
        "syn-chart-title"
      ],
      "notes": "Only styling hooks. Generate chart values and SVG geometry yourself."
    },
    {
      "name": "Heatmap",
      "module": "syntyr.viz.css",
      "elements": [
        "div",
        "span"
      ],
      "classes": [
        "syn-viz-heatmap",
        "syn-viz-cell"
      ],
      "notes": "Supply textual cell labels, data-syn-level and real data."
    },
    {
      "name": "Geospatial workspace",
      "module": "syntyr.geo.css",
      "elements": [
        "section",
        "aside",
        "figure",
        "div",
        "a",
        "button",
        "ul"
      ],
      "classes": [
        "syn-geo-shell",
        "syn-geo-workspace",
        "syn-geo-sidebar",
        "syn-geo-viewport",
        "syn-geo-map",
        "syn-geo-overlay",
        "syn-geo-controls",
        "syn-geo-control",
        "syn-geo-marker",
        "syn-geo-marker-layer",
        "syn-geo-cluster",
        "syn-geo-legend",
        "syn-geo-swatch",
        "syn-geo-scale",
        "syn-geo-attribution",
        "syn-geo-data-list"
      ],
      "notes": "Optional renderer-neutral CSS; load core then geo. The host renderer owns projection, attribution, marker positions, zooming, clustering and screen-reader data alternatives. See docs/geo.md."
    },
    {
      "name": "Advanced geometry frames",
      "module": "syntyr.geometry.css",
      "elements": [
        "article",
        "section",
        "div"
      ],
      "classes": [
        "syn-frame",
        "syn-frame--bevel",
        "syn-frame--notch",
        "syn-frame--bracket",
        "syn-frame--accent"
      ],
      "notes": "Load optional geometry CSS. One shape per frame; accent emphasis is additive. Refer to visual-intensity.md for pseudo-element ownership and backgrounds."
    },
    {
      "name": "Decorative effects",
      "module": "syntyr.effects.css",
      "elements": [
        "article",
        "section",
        "div"
      ],
      "classes": [
        "syn-glow",
        "syn-grid-effect",
        "syn-gradient-wash"
      ],
      "notes": "Optional CSS only. data-syn-intensity on .syn-root or nested regions selects quiet, standard or cinematic effects without changing semantic state."
    },
    {
      "name": "CRM compositions",
      "module": "syntyr.recipes.css",
      "elements": [
        "form",
        "label",
        "div",
        "section",
        "ul",
        "li",
        "dl"
      ],
      "classes": [
        "syn-filter-bar",
        "syn-filter-field",
        "syn-filter-field--query",
        "syn-filter-actions",
        "syn-pipeline",
        "syn-pipeline-lane",
        "syn-pipeline-list",
        "syn-pipeline-card",
        "syn-record-fields"
      ],
      "notes": "Unreleased alpha.5, CSS-only optional layouts. Use a GET form, labelled stages, focusable board overflow and definition-list details; application implements filtering and pipeline state."
    },
    {
      "name": "Operation feedback",
      "module": "syntyr.recipes.css",
      "elements": [
        "div",
        "section",
        "h2",
        "h3",
        "p"
      ],
      "classes": [
        "syn-operation-feedback"
      ],
      "notes": "Experimental alpha.5 static presentation only. Host must set true pending, saved, failed, conflict or unsaved state, manage requests, announcements, retry and authorization."
    },
    {
      "name": "Record change pair",
      "module": "syntyr.recipes.css",
      "elements": [
        "dl",
        "div",
        "dt",
        "dd",
        "span",
        "del",
        "ins"
      ],
      "classes": [
        "syn-record-fields",
        "syn-change-pair",
        "syn-change-before",
        "syn-change-after"
      ],
      "notes": "Experimental alpha.5 semantic before/after styling nested in existing record fields. Text labels and native del/ins convey changes; backend supplies true revision values and conflict policy."
    },
    {
      "name": "File lifecycle",
      "module": "syntyr.recipes.css",
      "elements": [
        "ol",
        "li",
        "div",
        "span",
        "strong",
        "progress"
      ],
      "classes": [
        "syn-file-queue",
        "syn-file-item",
        "syn-file-item-header"
      ],
      "notes": "Unreleased alpha.5 CSS-only queue snapshots. Native input lives in core; host owns upload progress, failure and completion truth, validation, retry, status announcements and storage."
    },
    {
      "name": "Native dropdowns and menus",
      "module": "syntyr.core.css",
      "elements": [
        "div",
        "a",
        "button",
        "select"
      ],
      "classes": [
        "syn-popover",
        "syn-dropdown",
        "syn-dropdown__item",
        "syn-dropdown__group-label",
        "syn-dropdown__separator",
        "syn-dropdown__shortcut",
        "syn-select--enhanced"
      ],
      "notes": "Scriptless action panels use Tab/Escape. Optional @syntyr/css/menu.mjs adds ARIA menu keyboard behavior only when explicitly initialized; see docs/dropdowns.md."
    }
  ],
  "recipes": [
    {
      "id": "crm-filter",
      "description": "Server-driven filter toolbar with wrapping fields and submit/reset actions.",
      "stylesheets": [
        "syntyr.core.css",
        "syntyr.recipes.css"
      ],
      "root": {
        "tag": "form",
        "classes": [
          "syn-filter-bar"
        ]
      },
      "slots": [
        {
          "name": "field",
          "tag": "label",
          "classes": [
            "syn-filter-field"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "query",
          "tag": "label",
          "classes": [
            "syn-filter-field",
            "syn-filter-field--query"
          ],
          "optional": true,
          "repeatable": false
        },
        {
          "name": "actions",
          "tag": "div",
          "classes": [
            "syn-filter-actions"
          ],
          "optional": false,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-density": [
          "comfortable",
          "compact"
        ]
      },
      "host_behavior": "Supply method=get, named controls, actual action URL and meaningful reset link. The host filters results; CSS does not execute queries.",
      "example": "examples/saas-workflows.html"
    },
    {
      "id": "resource-table",
      "description": "Horizontally scrollable semantic data table with optional numeric cells and native pagination links.",
      "stylesheets": [
        "syntyr.core.css"
      ],
      "root": {
        "tag": "div",
        "classes": [
          "syn-table-wrap"
        ]
      },
      "slots": [
        {
          "name": "table",
          "tag": "table",
          "classes": [
            "syn-table"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "numeric-cell",
          "tag": "td",
          "classes": [
            "syn-cell--numeric"
          ],
          "optional": true,
          "repeatable": true
        },
        {
          "name": "pagination",
          "tag": "nav",
          "classes": [
            "syn-pagination"
          ],
          "optional": true,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-density": [
          "comfortable",
          "compact"
        ]
      },
      "host_behavior": "Provide caption, real th scope associations, keyboard-reachable horizontal overflow where needed, actual page links and server-side sort/filter. CSS does not sort, page or select records.",
      "example": "examples/saas-workflows.html"
    },
    {
      "id": "app-shell",
      "description": "Responsive application shell with navigation rail and primary workspace.",
      "stylesheets": [
        "syntyr.core.css",
        "syntyr.recipes.css"
      ],
      "root": {
        "tag": "div",
        "classes": [
          "syn-app-shell"
        ]
      },
      "slots": [
        {
          "name": "rail",
          "tag": "aside",
          "classes": [
            "syn-app-rail"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "navigation",
          "tag": "nav",
          "classes": [
            "syn-app-nav"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "workspace",
          "tag": "main",
          "classes": [
            "syn-workspace"
          ],
          "optional": false,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-theme": [
          "studio",
          "grid",
          "noir"
        ]
      },
      "host_behavior": "Provide labelled navigation, unique main landmark, actual routes and authorization for each destination. Theme must be placed on .syn-root or a scoped ancestor.",
      "example": "examples/operations-console.html"
    },
    {
      "id": "validated-form",
      "description": "Labeled field/error compositions for host-validated forms.",
      "stylesheets": [
        "syntyr.core.css"
      ],
      "root": {
        "tag": "form",
        "classes": [
          "syn-form"
        ]
      },
      "slots": [
        {
          "name": "field",
          "tag": "div",
          "classes": [
            "syn-field"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "label",
          "tag": "label",
          "classes": [
            "syn-label"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "input",
          "tag": "input",
          "classes": [
            "syn-input"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "error",
          "tag": "p",
          "classes": [
            "syn-error"
          ],
          "optional": true,
          "repeatable": true
        }
      ],
      "variants": {
        "data-syn-density": [
          "comfortable",
          "compact"
        ]
      },
      "host_behavior": "Host supplies server/client validation, error text, stable error IDs, aria-describedby, aria-invalid and focus to an error summary when submission fails. CSS never performs validation or focus changes.",
      "example": "examples/form-composition.html"
    }
  ],
  "themes": [
    "amethyst",
    "auto",
    "corporate",
    "dim",
    "graphite",
    "grid",
    "industrial",
    "midnight",
    "minimal",
    "noir",
    "obsidian",
    "studio",
    "terminal"
  ],
  "examples": [
    {
      "id": "catalog-buttons-title",
      "title": "Buttons",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Use native buttons for actions; variants change appearance only.",
      "keywords": [
        "actions",
        "controls",
        "primary",
        "outline"
      ],
      "category": "interactive",
      "elements": [
        "button",
        "div"
      ],
      "classes": [
        "syn-button",
        "syn-button--outline",
        "syn-button--primary",
        "syn-inline"
      ],
      "html": "<div class=\"syn-inline\">\n  <button type=\"button\" class=\"syn-button syn-button--primary\">Save changes</button>\n  <button type=\"button\" class=\"syn-button syn-button--outline\">Preview</button>\n  <button type=\"button\" class=\"syn-button\" disabled>Disabled</button>\n</div>"
    },
    {
      "id": "catalog-forms-title",
      "title": "Labeled fields",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Use real labels and native validation; form submission belongs to your app.",
      "keywords": [
        "input",
        "text",
        "validation",
        "form",
        "accessibility"
      ],
      "category": "forms",
      "elements": [
        "div",
        "input",
        "label",
        "p"
      ],
      "classes": [
        "syn-form",
        "syn-help",
        "syn-input",
        "syn-label"
      ],
      "html": "<div class=\"syn-form\">\n  <label class=\"syn-label\" for=\"catalog-email\">Email address</label>\n  <input class=\"syn-input\" id=\"catalog-email\" type=\"email\" placeholder=\"you@example.com\" required>\n  <p class=\"syn-help\">Use your work email.</p>\n</div>"
    },
    {
      "id": "catalog-native-controls-title",
      "title": "Native range, file and color",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "One existing input class; native keyboard, picker and file selection behavior.",
      "keywords": [
        "native",
        "range",
        "file",
        "color",
        "slider",
        "upload",
        "chooser",
        "form"
      ],
      "category": "forms",
      "elements": [
        "div",
        "input",
        "label"
      ],
      "classes": [
        "syn-form",
        "syn-input",
        "syn-label"
      ],
      "html": "<div class=\"syn-form\" id=\"catalog-native-controls\">\n  <label class=\"syn-label\" for=\"catalog-range\">Threshold</label>\n  <input id=\"catalog-range\" type=\"range\" class=\"syn-input\" min=\"0\" max=\"100\" value=\"60\">\n  <label class=\"syn-label\" for=\"catalog-file\">Attach artwork</label>\n  <input id=\"catalog-file\" type=\"file\" class=\"syn-input\">\n  <label class=\"syn-label\" for=\"catalog-color\">Accent color</label>\n  <input id=\"catalog-color\" type=\"color\" class=\"syn-input\" value=\"#3355aa\">\n</div>"
    },
    {
      "id": "catalog-interaction-card-0",
      "title": "Exclusive accordion",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Related disclosures use native details name; no script or custom roles.",
      "keywords": [
        "native",
        "accordion",
        "faq",
        "details",
        "summary",
        "exclusive",
        "disclosure"
      ],
      "category": "interactive",
      "elements": [
        "details",
        "h3",
        "p",
        "section",
        "summary"
      ],
      "classes": [
        "syn-details"
      ],
      "html": "<section aria-labelledby=\"catalog-faq-heading\">\n  <h3 id=\"catalog-faq-heading\">Common questions</h3>\n  <details class=\"syn-details\" name=\"catalog-interaction-faq\" open>\n    <summary>Can I use standard HTML?</summary>\n    <p>Yes, Syntyr styles browser-native elements.</p>\n  </details>\n  <details class=\"syn-details\" name=\"catalog-interaction-faq\">\n    <summary>Do I need a JavaScript runtime?</summary>\n    <p>No. Native disclosures handle their own open state.</p>\n  </details>\n</section>"
    },
    {
      "id": "catalog-interaction-card-1",
      "title": "GET search form",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Real search landmark and GET submission; the static destination does not filter results.",
      "keywords": [
        "native",
        "search",
        "get",
        "landmark",
        "searchform",
        "filtering",
        "server"
      ],
      "category": "navigation",
      "elements": [
        "button",
        "form",
        "input",
        "label",
        "search"
      ],
      "classes": [
        "syn-button",
        "syn-button--primary",
        "syn-form",
        "syn-input",
        "syn-label"
      ],
      "html": "<search aria-label=\"Search example inventory\">\n  <form class=\"syn-form\" action=\"../examples/native-interactions.html\" method=\"get\">\n    <label class=\"syn-label\" for=\"catalog-inventory-query\">Inventory search</label>\n    <input class=\"syn-input\" id=\"catalog-inventory-query\" type=\"search\"\n           name=\"q\" required placeholder=\"Enter a keyword\">\n    <button class=\"syn-button syn-button--primary\" type=\"submit\">Search</button>\n  </form>\n</search>"
    },
    {
      "id": "catalog-interaction-card-2",
      "title": "Confirmation dialog",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Native modal command and dialog-only choices; confirming this preview does not persist changes.",
      "keywords": [
        "native",
        "dialog",
        "modal",
        "confirmation",
        "commandfor",
        "method",
        "dialog"
      ],
      "category": "interactive",
      "elements": [
        "button",
        "dialog",
        "div",
        "form",
        "h3",
        "p"
      ],
      "classes": [
        "syn-button",
        "syn-button--outline",
        "syn-button--primary",
        "syn-dialog",
        "syn-inline"
      ],
      "html": "<div class=\"syn-inline\">\n  <button type=\"button\" class=\"syn-button\" commandfor=\"catalog-interaction-dialog\"\n          command=\"show-modal\">Open confirmation</button>\n  <dialog class=\"syn-dialog\" id=\"catalog-interaction-dialog\"\n          aria-labelledby=\"catalog-interaction-dialog-title\">\n    <h3 id=\"catalog-interaction-dialog-title\">Confirm preview?</h3>\n    <p>This static example changes no data.</p>\n    <form method=\"dialog\" class=\"syn-inline\">\n      <button class=\"syn-button syn-button--outline\" type=\"submit\"\n              value=\"cancel\" autofocus>Cancel</button>\n      <button class=\"syn-button syn-button--primary\" type=\"submit\"\n              value=\"confirm\">Confirm preview</button>\n    </form>\n  </dialog>\n</div>"
    },
    {
      "id": "catalog-interaction-card-3",
      "title": "Datalist suggestions",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Browser suggestions for a free-text input; not a searchable select or combobox implementation.",
      "keywords": [
        "native",
        "datalist",
        "suggestions",
        "autocomplete",
        "input",
        "optgroup"
      ],
      "category": "forms",
      "elements": [
        "datalist",
        "div",
        "input",
        "label",
        "option"
      ],
      "classes": [
        "syn-form",
        "syn-input",
        "syn-label"
      ],
      "html": "<div class=\"syn-form\">\n  <label class=\"syn-label\" for=\"catalog-suggested-city\">City</label>\n  <input class=\"syn-input\" id=\"catalog-suggested-city\" name=\"city\"\n         list=\"catalog-city-options\" placeholder=\"Start typing a city\">\n  <datalist id=\"catalog-city-options\">\n    <option value=\"Brasília\"></option>\n    <option value=\"Chicago\"></option>\n    <option value=\"New York\"></option>\n  </datalist>\n</div>"
    },
    {
      "id": "catalog-interaction-card-4",
      "title": "Meter and output",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css",
        "syntyr.semantic.css"
      ],
      "description": "Native bounded measurements and static server result; calculations belong to the host.",
      "keywords": [
        "native",
        "meter",
        "output",
        "capacity",
        "calculation",
        "progress",
        "gauge"
      ],
      "category": "data",
      "elements": [
        "div",
        "label",
        "meter",
        "output"
      ],
      "classes": [
        "syn-semantic",
        "syn-stack"
      ],
      "html": "<div class=\"syn-semantic syn-stack\">\n  <label for=\"catalog-capacity-meter\">Utilization</label>\n  <meter id=\"catalog-capacity-meter\" min=\"0\" max=\"100\" low=\"20\"\n         high=\"85\" optimum=\"40\" value=\"68\">68%</meter>\n  <label for=\"catalog-inventory-output\">Matching inventory</label>\n  <output id=\"catalog-inventory-output\" name=\"results\">42 available locations</output>\n</div>"
    },
    {
      "id": "catalog-panels-title",
      "title": "Panels and token overrides",
      "module": "syntyr.core.css",
      "required_stylesheets": [
        "syntyr.core.css"
      ],
      "description": "Override component tokens locally without rebuilding the stylesheet.",
      "keywords": [
        "surface",
        "card",
        "border",
        "padding",
        "radius",
        "css",
        "variables"
      ],
      "category": "layout",
      "elements": [
        "article",
        "h3",
